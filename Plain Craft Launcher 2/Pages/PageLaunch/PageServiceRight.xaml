<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageServiceRight"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard x:Name="CardDeploy" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="部署内嵌运行时" FontWeight="Bold" FontSize="15" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                               Text="首次使用需要把随程序分发的内嵌运行时导入 WSL（自动完成：导入专用发行版、就绪 Docker、导入服务镜像），全程无需手动安装任何组件。" />
                    <local:MyButton x:Name="BtnDeploy" Height="35" Width="140" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Text="开始部署" ColorType="Highlight"
                                    Click="BtnDeploy_Click" />
                    <TextBlock x:Name="LabDeployProgress" Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="运行状态" FontWeight="Bold" FontSize="15" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                               Text="查看容器 CPU/内存占用、当前编译任务与运行日志；服务卡死时可一键重启。宏包管理可直接搜索安装 TeX 宏包。" />
                    <!-- 右栏可用宽度约 440px（窗口 850 - 左栏 300 - 边距），
                         四个 130px 按钮横排共需 550px，超出部分会被 MyScrollViewer 裁剪，
                         故用 WrapPanel：宽度不足时自动换行，避免「环境自检」按钮被截断。 -->
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnServiceStatus" Height="34" Width="130" Margin="0,0,10,10"
                                        Text="查看服务状态" ColorType="Highlight"
                                        Click="BtnServiceStatus_Click" />
                        <local:MyButton x:Name="BtnPackages" Height="34" Width="130" Margin="0,0,10,10"
                                        Text="宏包管理" Click="BtnPackages_Click" />
                        <local:MyButton x:Name="BtnAccounts" Height="34" Width="130" Margin="0,0,10,10"
                                        Text="账号管理" Click="BtnAccounts_Click" />
                        <local:MyButton x:Name="BtnEnvironment" Height="34" Width="130" Margin="0,0,0,10"
                                        Text="环境自检" Click="BtnEnvironment_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="中文模板库" FontWeight="Bold" FontSize="15" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                               Text="内置中学试卷、本科毕设、竞赛报告、国内期刊投稿四类常用中文场景模板：一键新建项目，创建后即可直接编译。" />
                    <local:MyButton x:Name="BtnTemplates" Height="34" Width="130" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Text="浏览模板库" ColorType="Highlight"
                                    Click="BtnTemplates_Click" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="网络与协作" FontWeight="Bold" FontSize="15" />
                    <local:MyCheckBox x:Name="CheckLanAccess" Margin="0,10,0,0"
                                      Text="允许局域网访问（团队协作）"
                                      Change="CheckLanAccess_Change" />
                    <TextBlock x:Name="LabLanAddress" Margin="0,8,0,0" FontSize="12" Opacity="0.75"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                               Text="开启后同一局域网内的队友可通过上方地址访问、注册账号并实时协同编辑；关闭后仅本机可访问。修改后重启服务生效。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="功能速览" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <local:MyButton Grid.Column="1" x:Name="BtnRefreshFeatures" Height="30" Width="80"
                                        Text="刷新" Click="BtnRefreshFeatures_Click" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                               Text="按当前配置实际生效的功能（开关开启且必要凭据齐全）。各项开关在「设置 → Ayakaleaf」中调整。" />
                    <WrapPanel x:Name="PanFeatureChips" Margin="0,10,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="容器" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <local:MyButton Grid.Column="1" x:Name="BtnRefreshContainers" Height="30" Width="80"
                                        Text="刷新" Click="BtnRefreshContainers_Click" />
                    </Grid>
                    <StackPanel x:Name="PanContainers" Margin="0,10,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="服务日志" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <local:MyButton Grid.Column="1" x:Name="BtnRefreshLog" Height="30" Width="80"
                                        Text="刷新日志" Click="BtnRefreshLog_Click" />
                    </Grid>
                    <Border Margin="0,10,0,0" Background="#14101010" CornerRadius="4" Padding="10,8">
                        <TextBlock x:Name="LabLog" FontFamily="Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Text="（暂无日志）" />
                    </Border>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
