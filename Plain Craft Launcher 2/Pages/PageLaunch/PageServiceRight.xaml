<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageServiceRight"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard x:Name="CardDeploy" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="部署内嵌运行时" FontWeight="Bold" FontSize="15" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                               Text="首次使用需要把随程序分发的内嵌运行时导入 WSL（自动完成：导入专用发行版、就绪 Docker、导入服务镜像），全程无需手动安装任何组件。" />
                    <local:MyButton x:Name="BtnDeploy" Height="35" Width="140" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Text="开始部署" ColorType="Highlight"
                                    Click="BtnDeploy_Click" />
                    <TextBlock x:Name="LabDeployProgress" Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="网络与协作" FontWeight="Bold" FontSize="15" />
                    <local:MyCheckBox x:Name="CheckLanAccess" Margin="0,10,0,0"
                                      Text="允许局域网访问（团队协作）"
                                      Change="CheckLanAccess_Change" />
                    <TextBlock x:Name="LabLanAddress" Margin="0,8,0,0" FontSize="12" Opacity="0.75"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                               Text="开启后同一局域网内的队友可通过上方地址访问、注册账号并实时协同编辑；关闭后仅本机可访问。修改后重启服务生效。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="容器" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <local:MyButton Grid.Column="1" x:Name="BtnRefreshContainers" Height="30" Width="80"
                                        Text="刷新" Click="BtnRefreshContainers_Click" />
                    </Grid>
                    <StackPanel x:Name="PanContainers" Margin="0,10,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="服务日志" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <local:MyButton Grid.Column="1" x:Name="BtnRefreshLog" Height="30" Width="80"
                                        Text="刷新日志" Click="BtnRefreshLog_Click" />
                    </Grid>
                    <Border Margin="0,10,0,0" Background="#14101010" CornerRadius="4" Padding="10,8">
                        <TextBlock x:Name="LabLog" FontFamily="Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Text="（暂无日志）" />
                    </Border>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
