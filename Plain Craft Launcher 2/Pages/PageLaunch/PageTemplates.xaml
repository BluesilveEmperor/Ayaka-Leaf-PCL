<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageTemplates"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Margin="0,0,0,15" Title="中文模板库">
                <StackPanel Margin="20,40,20,15">
                    <TextBlock FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                               Text="内置中学试卷、本科毕设、竞赛报告、国内期刊投稿四类常用中文场景模板：一键新建项目，创建后即可直接编译（XeLaTeX，随镜像内置中文字体）。模板随启动器版本更新，已创建的项目不受影响。" />
                    <TextBlock x:Name="LabStatus" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="选择一个模板，点击「一键新建」即可创建并打开项目。" />
                    <WrapPanel x:Name="PanTemplates" Margin="0,14,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
