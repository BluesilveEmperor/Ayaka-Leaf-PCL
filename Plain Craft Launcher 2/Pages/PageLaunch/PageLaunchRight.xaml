<local:MyPageRight x:Class="PCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,0,0,15" Title="AyakaLauncher" x:Name="PanWelcome">
                <StackPanel Margin="25,38,23,15">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="14" FontWeight="Bold"
                               Text="本地用户版启动器" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" Opacity="0.85"
                               Text="· 在「启动」页点击「本地用户」注册账号并登录，首个注册的账号自动成为管理员。" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" Opacity="0.85"
                               Text="· 每个用户拥有完全独立的游戏数据目录（版本、存档、Mod、配置互不干扰）。" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" Opacity="0.85"
                               Text="· 启动游戏前需要先登录本地用户；管理员可在「本地用户」页管理全部账号。" />
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Opacity="0.55"
                               Text="本版本为离线本地使用，不连接任何社区服务。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
