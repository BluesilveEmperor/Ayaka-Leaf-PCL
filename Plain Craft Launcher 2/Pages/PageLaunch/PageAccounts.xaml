<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageAccounts"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Margin="0,0,0,15" Title="账号">
                <StackPanel Margin="20,40,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextKeyword" Grid.Column="0" Height="34" FontSize="13"
                                         HintText="按邮箱或姓名筛选，留空列出全部账号" />
                        <local:MyButton x:Name="BtnRefresh" Grid.Column="1" Height="34" Width="96"
                                        Margin="10,0,0,0" Text="刷新" ColorType="Highlight"
                                        Click="BtnRefresh_Click" />
                    </Grid>
                    <TextBlock x:Name="LabStatus" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="正在读取账号列表…" />
                    <local:MyHint Margin="0,10,0,0" Theme="Blue"
                                  Text="当前部署已关闭邮箱确认，注册即生效、没有独立的“待审批”状态。「审批」以停用/启用实现：可疑账号先停用（立即无法登录，即“拒绝”），确认后再启用。注册策略（开放/域名列表/关闭）可在 Ayakaleaf 设置页调整。" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Text="停用后该账号立即无法登录，可随时启用；重置密码会生成一次性随机密码，需转告给对应用户。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="账号列表">
                <StackPanel x:Name="PanAccounts" Margin="20,40,20,15" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
