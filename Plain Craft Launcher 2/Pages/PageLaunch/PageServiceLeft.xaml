<local:MyPageLeft x:Class="PCL.PageServiceLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d" d:DesignHeight="417.2" Width="300">
    <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="22,15,22,5">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="DotStatus" Width="13" Height="13" VerticalAlignment="Center" Fill="#9E9E9E" />
                <TextBlock x:Name="LabStatus" Text="检查中…" FontSize="20" FontWeight="Bold" Margin="9,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="LabStatusInfo" Text="" FontSize="12" Opacity="0.7" Margin="0,7,0,0"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="LabSiteUrl" Text="" FontSize="12" Opacity="0.55" Margin="0,3,0,0" />
        </StackPanel>
        <local:MyButton Grid.Row="2" x:Name="BtnStart" Height="54" Margin="20,10" Text="启动 Ayakaleaf"
                        ColorType="Highlight" Click="BtnStart_Click" IsEnabled="False" />
        <Grid Grid.Row="3" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <local:MyButton Grid.Column="0" x:Name="BtnStop" Height="35" Text="停止服务"
                            Click="BtnStop_Click" IsEnabled="False" />
            <local:MyButton Grid.Column="2" x:Name="BtnOpen" Height="35" Text="打开工作台"
                            Click="BtnOpen_Click" IsEnabled="False" />
        </Grid>
        <TextBlock Grid.Row="4" x:Name="LabProgress" Margin="22,8,22,0" FontSize="12" Opacity="0.7"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <local:MyButton Grid.Row="5" x:Name="BtnAccount" Height="35" Margin="20,10,20,0" Text="账户"
                        Click="BtnAccount_Click" />
    </Grid>
</local:MyPageLeft>
