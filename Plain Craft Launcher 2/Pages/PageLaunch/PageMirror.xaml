<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageMirror"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="镜像列表" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <local:MyButton Grid.Column="1" x:Name="BtnRefreshImages" Height="30" Width="80"
                                        Text="刷新" Click="BtnRefreshImages_Click" />
                    </Grid>
                    <StackPanel x:Name="PanImages" Margin="0,10,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="导入镜像" FontWeight="Bold" FontSize="15" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                               Text="选择随更新包分发的镜像文件（.tar 或 .tar.gz）导入运行时，用于 Ayakaleaf 升级。大文件导入需要数分钟，请耐心等待。" />
                    <local:MyButton x:Name="BtnImport" Height="35" Width="180" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Text="选择镜像文件并导入" ColorType="Highlight"
                                    Click="BtnImport_Click" />
                    <TextBlock x:Name="LabImportProgress" Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
