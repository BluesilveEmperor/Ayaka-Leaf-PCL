<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PagePackages"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Margin="0,0,0,15" Title="搜索宏包">
                <StackPanel Margin="20,40,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextKeyword" Grid.Column="0" Height="34" FontSize="13"
                                         HintText="宏包名或关键字，例如 mhchem / tikz / algorithm" />
                        <local:MyButton x:Name="BtnSearch" Grid.Column="1" Height="34" Width="96"
                                        Margin="10,0,0,0" Text="搜索" ColorType="Highlight"
                                        Click="BtnSearch_Click" />
                    </Grid>
                    <TextBlock x:Name="LabStatus" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="输入关键字后回车或点搜索。留空搜索会列出已安装宏包。" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                               Text="安装与卸载直接作用于服务容器内的 TeX Live，无需进入容器命令行；卸载集合类（collection-*）会被拒绝，以免破坏镜像约定。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="结果">
                <StackPanel x:Name="PanResults" Margin="20,40,20,15" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
