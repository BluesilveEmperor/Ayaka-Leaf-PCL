<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageCollab"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Margin="0,0,0,15" Title="协作状态">
                <StackPanel Margin="20,40,20,15">
                    <TextBlock x:Name="LabStatus" TextWrapping="Wrap" FontSize="13" Text="未开启协作。" />
                    <TextBlock x:Name="LabNodes" Margin="0,6,0,0" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="LabMembersTitle" Text="网络成员" FontWeight="Bold" FontSize="13"
                               Margin="0,12,0,0" Visibility="Collapsed" />
                    <StackPanel x:Name="PanMembers" Margin="0,6,0,0" />
                    <local:MyButton x:Name="BtnStop" Height="35" Width="110" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Text="停止协作" ColorType="Red"
                                    Visibility="Collapsed" Click="BtnStop_Click" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="我是房主">
                <StackPanel Margin="20,40,20,15">
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="开启后，本机 Ayakaleaf 服务将通过虚拟网络对队友开放。把邀请码发给队友即可邀请其加入，无需公网 IP 或端口映射。队友的访问流量经公共节点中转，敏感信息（文档内容）不会在节点明文传输。" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnStartHost" Height="35" Width="130" Margin="0,0,15,0"
                                        HorizontalAlignment="Left" Text="开启协作" ColorType="Highlight"
                                        Click="BtnStartHost_Click" />
                        <local:MyButton Grid.Column="1" x:Name="BtnCopyCode" Height="35" Width="110"
                                        Text="复制邀请码" Visibility="Collapsed" Click="BtnCopyCode_Click" />
                    </Grid>
                    <TextBlock x:Name="LabInviteCode" Margin="0,10,0,0" FontSize="14" FontWeight="Bold"
                               Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="我是队友">
                <StackPanel Margin="20,40,20,15">
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                               Text="输入房主分享的邀请码加入协作网络，即可访问房主的 Ayakaleaf 服务。首次访问需在房主的服务中注册或登录账号。" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextInvite" HintText="A/XXXX-XXXX-XXXX-XXXX" FontSize="14"
                                         VerticalAlignment="Center" />
                        <local:MyButton Grid.Column="1" x:Name="BtnJoin" Height="34" Width="110" Margin="10,0,0,0"
                                        Text="加入协作" ColorType="Highlight" Click="BtnJoin_Click" />
                    </Grid>
                    <StackPanel x:Name="PanForwards" Margin="0,10,0,0" />
                    <local:MyButton x:Name="BtnOpenWorkbench" Height="35" Width="130" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Text="打开工作台" ColorType="Highlight"
                                    Visibility="Collapsed" Click="BtnOpenWorkbench_Click" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
