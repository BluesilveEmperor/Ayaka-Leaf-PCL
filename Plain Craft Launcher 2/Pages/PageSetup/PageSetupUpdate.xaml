<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageSetupUpdate"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Height="Auto">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <Image Source="pack://application:,,,/Images/icon.png" Grid.Column="0" Grid.Row="0"
                               Grid.RowSpan="3" Height="50" Width="50" HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="TextCurrentVersion" Text="AyakaLauncher" FontWeight="Bold" FontSize="20"
                                   Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="TextCurrentDesc" Text="正在使用 GitHub Releases 更新通道" FontSize="14" Grid.Row="2" Grid.Column="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Height="Auto" Margin="0,15" x:Name="CardUpdateChannel">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="更新通道" FontWeight="Bold" />
                    <local:MyCheckBox x:Name="CheckUpdateEnabled" Text="启用更新通道" Height="22" Margin="-1,10,0,7"
                                      Change="CheckUpdateEnabled_OnChange" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="更新方式：" VerticalAlignment="Center" />
                        <local:MyComboBox x:Name="ComboUpdateMode" Grid.Column="1" VerticalAlignment="Center"
                                          SelectionChanged="ComboUpdateMode_OnChange">
                            <local:MyComboBoxItem Content="自动下载并安装" />
                            <local:MyComboBoxItem Content="自动下载并提示更新" />
                            <local:MyComboBoxItem Content="仅提示有新版本" />
                            <local:MyComboBoxItem Content="不自动检查" />
                        </local:MyComboBox>
                        <local:MyButton x:Name="BtnCheckUpdate" Grid.Column="3" Text="检查更新" Padding="15,6"
                                        Click="BtnCheckUpdate_Click" />
                    </Grid>
                    <TextBlock x:Name="TextUpdateChannelDesc" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Height="Auto" Margin="0,15">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="更新说明" FontWeight="Bold" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="更新通过 GitHub Releases 分发，下载完成后进行 SHA256 校验，再自动替换程序文件。若加速站点不可用会自动回退直连。" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="版本号为本项目独立版本线，与上游 PCL2-CE 无关。旧版本（2.0.0 及之前未启用更新通道的版本）需手动下载一次新版 exe 替换，此后即可在线更新。已有账号数据与配置不受升级影响。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
