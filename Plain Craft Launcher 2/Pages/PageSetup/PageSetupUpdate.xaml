<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageSetupUpdate"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Height="Auto">
                <StackPanel Margin="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <Image Source="pack://application:,,,/Images/icon.png" Grid.Column="0" Grid.Row="0"
                               Grid.RowSpan="3" Height="50" Width="50" HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="TextCurrentVersion" Text="AyakaLauncher" FontWeight="Bold" FontSize="20"
                                   Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="TextCurrentDesc" Text="本地版未启用在线更新" FontSize="14" Grid.Row="2" Grid.Column="2"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Height="Auto" Margin="0,15">
                <StackPanel Margin="20,15,20,15">
                    <TextBlock Text="更新说明" FontWeight="Bold" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="AyakaLauncher 为本地分发的定制版本，未启用在线更新功能。" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="如需升级，请向版本提供方获取最新的发行包，直接替换本程序文件即可。已有账号数据与游戏目录会自动保留，不受升级影响。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
