<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0-windows</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>PCL</RootNamespace>
        <MyType>Custom</MyType>
        <IsWebBootstrapper>false</IsWebBootstrapper>
        <StartupObject>PCL.Program</StartupObject>
        <PublishUrl>publish\</PublishUrl>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <MapFileExtensions>true</MapFileExtensions>
        <TargetCulture>zh-CN</TargetCulture>
        <UseApplicationTrust>false</UseApplicationTrust>
        <BootstrapperEnabled>true</BootstrapperEnabled>
        <LangVersion>14</LangVersion>
        <UseWPF>true</UseWPF>
        <Configurations>Beta;Debug;Release;CI</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Images\icon.ico</ApplicationIcon>
        <AssemblyName>AyakaLauncher</AssemblyName>
        <AssemblyTitle>AyakaLauncher</AssemblyTitle>
        <Description>Ayakaleaf 桌面管理器：内嵌运行时部署、服务启停、镜像与数据管理</Description>
        <Product>AyakaLauncher</Product>
        <Copyright>Copyright © 龙腾猫跃 2016. All Rights Reserved.</Copyright>
        <AssemblyVersion>2.1.0.0</AssemblyVersion>
        <FileVersion>2.1.0.0</FileVersion>
        <NoWarn>
            41999;42016;42017;42018;42019;42020;42021;42022;42032;42036;42314;
            VSTHRD002;VSTHRD003;VSTHRD110;VSTHRD200
        </NoWarn>
        <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
        <CETCompat>false</CETCompat>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>bin\Debug\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>TRACE;DEBUG</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'CI' Or '$(Configuration)' == 'DebugCI'">
        <OutputPath>bin\CI\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>TRACE;DEBUGCI</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>bin\Release\</OutputPath>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>RELEASE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Beta'">
        <OutputPath>bin\Beta\</OutputPath>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>BETA</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="DotNet.Glob" Version="3.1.3" />
        <PackageReference Include="Downloader" Version="5.9.4" />
        <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
        <PackageReference Include="NAudio" Version="2.3.0" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="System.Text.Json" />
        <Using Include="System.Text.Json.Nodes" />
    </ItemGroup>
    <ItemGroup>
        <Import Include="System.IO" />
        <Import Include="System.Net" />
        <Import Include="System.Text" />
        <Import Include="System.Threading" />
        <Import Include="System.Windows" />
        <Import Include="System.Windows.Controls" />
        <Import Include="System.Windows.Data" />
        <Import Include="System.Windows.Documents" />
        <Import Include="System.Windows.Input" />
        <Import Include="System.Windows.Shapes" />
        <Import Include="System.Windows.Media" />
        <Import Include="System.Windows.Media.Imaging" />
    </ItemGroup>
    <!-- 信不过巨硬的智障代码，手动包含需要的文件 -->
    <PropertyGroup>
        <EnableDefaultItems>false</EnableDefaultItems>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
        <EnableDefaultPageItems>false</EnableDefaultPageItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="**\*.cs" Exclude="bin\**;obj\**;publish\**" />
        <ApplicationDefinition Include="Application.xaml" Condition="Exists('Application.xaml')" />
        <ApplicationDefinition Include="App.xaml" Condition="Exists('App.xaml')" />
        <Page Include="**\*.xaml" Exclude="bin\**;obj\**;@(ApplicationDefinition)" />
        <Resource Include="Images\**" />
        <Resource Include="Resources\**" />
        <EmbeddedResource Include="metadata.json" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="LICENCE" />
    </ItemGroup>
    <!-- Ayakaleaf 内嵌运行时（仓库根 runtime\，约 2.6GB，不入库）：
         构建后以目录联接（junction）方式挂到输出目录，避免每次构建复制 2.6GB。
         部署发布包由 artifact + runtime 重新组装（见 .gitignore 中 dist 说明）。 -->
    <!-- 注意：$(OutDir) 在项目体属性求值阶段为空（由 Sdk.targets 后置赋值），
         必须在 Target 执行时计算，否则联接路径会错算到项目目录。 -->
    <PropertyGroup>
        <AyakaleafRuntimeSource>$(MSBuildThisFileDirectory)..\runtime</AyakaleafRuntimeSource>
    </PropertyGroup>
    <Target Name="LinkAyakaleafRuntime" AfterTargets="Build" Condition="Exists('$(AyakaleafRuntimeSource)\images')">
        <PropertyGroup>
            <AyakaleafRuntimeLink>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutDir)runtime'))</AyakaleafRuntimeLink>
        </PropertyGroup>
        <Message Importance="high" Text="链接内嵌运行时: $(AyakaleafRuntimeLink) -> $(AyakaleafRuntimeSource)" />
        <Exec Command="cmd /c if exist &quot;$(AyakaleafRuntimeLink)&quot; rmdir &quot;$(AyakaleafRuntimeLink)&quot; &amp; mklink /J &quot;$(AyakaleafRuntimeLink)&quot; &quot;$(AyakaleafRuntimeSource)&quot;" />
    </Target>
    <!-- dotnet publish 同理：publish 输出目录（默认 bin\...\publish\，或 -o 指定如 artifact\）
         里的 exe 供本机直接运行，同样需要 runtime\images 就位，Publish 后也挂联接。
         $(PublishDir) 相对时基于项目目录拼接，绝对时（-o 传绝对路径）直接使用，
         不能盲目拼接（GetFullPath 对"相对前缀+绝对路径"会抛 NotSupportedException）。
         CI 上仓库无 runtime\，Condition 不满足即整体跳过，publish 产物保持纯净。 -->
    <Target Name="LinkAyakaleafRuntimeOnPublish" AfterTargets="Publish" Condition="Exists('$(AyakaleafRuntimeSource)\images')">
        <PropertyGroup>
            <!-- MSBuild 条件表达式不支持嵌套单引号：先求布尔值再比较 -->
            <AyakaleafPublishDirIsRooted>$([System.IO.Path]::IsPathRooted('$(PublishDir)'))</AyakaleafPublishDirIsRooted>
            <AyakaleafRuntimePublishLink Condition="'$(AyakaleafPublishDirIsRooted)' == 'True'">$([System.IO.Path]::GetFullPath('$(PublishDir)runtime'))</AyakaleafRuntimePublishLink>
            <AyakaleafRuntimePublishLink Condition="'$(AyakaleafPublishDirIsRooted)' != 'True'">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(PublishDir)runtime'))</AyakaleafRuntimePublishLink>
        </PropertyGroup>
        <Message Importance="high" Text="链接内嵌运行时: $(AyakaleafRuntimePublishLink) -> $(AyakaleafRuntimeSource)" />
        <Exec Command="cmd /c if exist &quot;$(AyakaleafRuntimePublishLink)&quot; rmdir &quot;$(AyakaleafRuntimePublishLink)&quot; &amp; mklink /J &quot;$(AyakaleafRuntimePublishLink)&quot; &quot;$(AyakaleafRuntimeSource)&quot;" />
    </Target>
</Project>
